default:
    @just --list

# Enter a devshell with sops/age/ssh-to-age/rbw on PATH
dev:
    nix develop

# Edit (or create) an encrypted file under store/ — re-encrypts on save
edit FILE="secrets.yaml":
    nix develop -c sops store/{{FILE}}

# Decrypt an encrypted file to stdout
view FILE="secrets.yaml":
    nix develop -c sops -d store/{{FILE}}

# Re-encrypt every stored secret to the current .sops.yaml recipients
rekey:
    #!/usr/bin/env bash
    set -euo pipefail
    shopt -s nullglob
    for f in store/*.yaml store/*.json store/*.env; do
        echo "rekey $f"
        nix develop -c sops updatekeys -y "$f"
    done

# Print the age public key derived from a machine's SSH key (feed the private key)
add-machine SSHKEY:
    #!/usr/bin/env bash
    set -euo pipefail
    nix develop -c ssh-to-age < {{SSHKEY}}.pub
    echo "^ add this under age: in .sops.yaml, then run: just rekey"

# Decrypt one stored key into a file (e.g. carry an SSH key to a new machine)
deploy-ssh KEY="ssh_ed25519_private" DEST="":
    #!/usr/bin/env bash
    set -euo pipefail
    dest="{{DEST}}"
    [ -n "$dest" ] || dest="$HOME/.ssh/id_ed25519"
    mkdir -p "$(dirname "$dest")"
    nix develop -c sops -d --extract '["{{KEY}}"]' store/secrets.yaml > "$dest"
    chmod 600 "$dest"
    echo "wrote $dest"
